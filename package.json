{
  "name": "@mateusjrcavalcanti/react-smartphone-ui",
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "private": false,
  "type": "module",
  "files": ["dist"],
  "main": "./dist/react-smartphone-ui.js",
  "module": "./dist/react-smartphone-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-smartphone-ui.js"
    },
    "./styles.css": "./dist/react-smartphone-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:pages": "tsc --noEmit -p tsconfig.app.json && vite build --mode pages",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
